{
  "scripts": {
    "lint:js": "eslint 'app/packs/**/*.js'",
    "lint:scss": "stylelint 'app/packs/**/*.scss'",
    "fix:js": "eslint 'app/packs/**/*.js' --fix",
    "fix:scss": "stylelint 'app/packs/**/*.scss' --fix",
    "lint": "npm run lint:js && npm run lint:scss",
    "fix": "npm run fix:js && npm run fix:scss",
    "prettier": "prettier --check '**/*.{js,scss}'",
    "prettify": "prettier --write '**/*.{js,scss}'"
  },
  "keywords": [
    "decidim"
  ],
  "author": "",
  "license": "AGPL-3.0-or-later",
  "stylelint": {
    "extends": "@decidim/stylelint-config"
  },
  "prettier": "@decidim/prettier-config",
  "eslintConfig": {
    "extends": "@decidim/eslint-config"
  },
  "devDependencies": {
    "@decidim/dev": "0.29.4",
    "@decidim/eslint-config": "0.29.4",
    "@decidim/prettier-config": "0.29.4",
    "@decidim/stylelint-config": "0.29.4",
    "postcss-scss": "^4.0.9"
  }
}
